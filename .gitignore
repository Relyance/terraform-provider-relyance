# Built provider binary at repo root (anchored, so it does NOT match
# cmd/terraform-provider-relyance/, which holds the tracked entrypoint).
/terraform-provider-relyance
dist/
*.tfstate*
.terraform/
.terraform.lock.hcl
*.tfvars
*.tfvars.json
*.env
secrets.env
.tfrc
dev.tfrc
*.pem
*.key

# The release workflow's semantic-release step yarn-installs into .github/ on the
# runner; an untracked node_modules/ makes GoReleaser's dirty-state check refuse
# to release (the first v1.0.0 attempt failed exactly here).
node_modules/
